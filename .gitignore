


# ==========================================
#  .gitignore for LaTeX assignments
#  追跡するのは .tex / .pdf / .bib のみ
# ==========================================

# ---- macOS ----
.DS_Store
.AppleDouble
.LSOverride
._*

# ---- Windows ----
Thumbs.db
ehthumbs.db
Desktop.ini

# ==========================================
#  build ディレクトリ
#  → 中身は無視、ただし PDF だけ追跡する
# ==========================================
build/*
!build/*.pdf
**/build/*
!**/build/*.pdf

# ==========================================
#  LaTeX 中間ファイル(どこにあっても無視)
# ==========================================
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.bbl
*.blg
*.bcf
*.run.xml
*.synctex.gz
*.synctex(busy)
*.dvi
*.ps
*.fdb_latexmk
*.fls
*.xdv

# ---- glossaries / acronyms ----
*.acn
*.acr
*.alg
*.glg
*.glo
*.gls
*.glsdefs
*.ist

# ---- index ----
*.idx
*.ilg
*.ind
*.loa

# ---- beamer ----
*.nav
*.snm
*.vrb

# ---- その他一時ファイル ----
*.tmp
*.bak
*.swp
*.figlist
*.makefile
*.fdb
*.fmt
*.pre
*.tdo
*.upa
*.upb
*.xml
*.auxlock

# ==========================================
#  エディタ / ツール
# ==========================================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
